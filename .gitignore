## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
.vs/

# Local History for Visual Studio
.localhistory/

# Visual Studio History (VSHistory) files
.vshistory/

# Local History for Visual Studio Code
.history/

.editorconfig

__pycache__/
*.pyc
*.pyo
*.pyd

# Optional but nice
.env
.vscode/

# Build artifacts
dist/
build/
installer/

# Python cache
__pycache__/
*.pyc

# PyInstaller
*.spec

# Misc
*.log
# Visual Studio
*.pyproj
*.pyproj.user
*.slnx

# Packaging
*.spec
*.iss
*.ico
/UpgradeLog.htm
/UpgradeLog2.htm
